# Grant read/write access to HackRF device nodes, and keep them awake.
#
# Distro hackrf packages typically ship a rule granting access with
# TAG+="uaccess" alone. That is an ACL logind hands to a user with an active
# local seat, so on a headless machine reached over SSH nothing is granted:
# the node stays root:root 0664, readable but not writable, and the radio
# cannot be opened. Symptom: "HackRF is present at /dev/bus/usb/... but could
# not be opened".
#
# The second job here is USB autosuspend, a known HackRF problem. For a daemon
# that streams continuously the failure mode is nasty: a suspended device
# fails its next bulk transfer while still answering control transfers, so a
# recovery check based on identifying the device restarts straight into the
# same failure.
#
# This file supplements rather than replaces a packaged rule, so device ids
# keep coming from the package; the higher number makes it win for MODE and
# GROUP. Change `wheel` to any group you belong to.
#
# Install as root:
#   cp deploy/60-hackrf-access.rules /etc/udev/rules.d/
#   udevadm control --reload-rules && udevadm trigger
#
# NOT ENOUGH ON A LAPTOP RUNNING TLP. TLP applies its own USB power policy
# after udev and will turn autosuspend back on, so the device also has to be
# listed there:
#   /etc/tlp.d/10-hackrf.conf:  USB_DENYLIST="1d50:6089"
#   systemctl restart tlp
# (`USB_DENYLIST` since TLP 1.4; older versions call it `USB_BLACKLIST`.)

# Access. Kept on separate lines from power management, so a mistake in one
# cannot take the other down with it.
ATTR{idVendor}=="1d50", ATTR{idProduct}=="6089", MODE="0660", GROUP="wheel"
ATTR{idVendor}=="1d50", ATTR{idProduct}=="604b", MODE="0660", GROUP="wheel"
ATTR{idVendor}=="1d50", ATTR{idProduct}=="cc15", MODE="0660", GROUP="wheel"
# NXP DFU bootloader, for firmware recovery
ATTR{idVendor}=="1fc9", ATTR{idProduct}=="000c", MODE="0660", GROUP="wheel"

# Power. Separate lines, matched on the USB device itself: `power/control` is
# reported to be unreliable when set from udev (systemd#14491), so use the
# autosuspend timer, which is the form the HackRF community documents.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6089", ATTR{power/autosuspend}="-1"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="604b", ATTR{power/autosuspend}="-1"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="cc15", ATTR{power/autosuspend}="-1"
